@model ProyectoGestiónParqueos.Models.reporteParqueo

@{
    ViewData["Title"] = "Crear Reporte";
}

<div class="d-flex justify-content-center align-items-center"
     style="background-color:#d5d0c4; min-height:100vh; padding:30px;">
    <div class="card p-4 border-0 shadow-sm bg-light" style="max-width:500px; width:100%;">
        <h4 class="text-center mb-4">Crear Reporte</h4>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <strong>Errores encontrados:</strong>
                <ul>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form asp-controller="Reportes" asp-action="CrearReporte" method="post">

            <div class="mb-3">
                <label class="form-label">Parqueo *</label>
                <select asp-for="id_asignacionP" class="form-control" asp-items="ViewBag.Asignaciones">
                    <option value="">Seleccione una asignación</option>
                </select>
                @if (ViewData.ModelState["id_asignacionP"]?.Errors?.Count > 0)
                {
                    <span class="text-danger">@ViewData.ModelState["id_asignacionP"].Errors[0].ErrorMessage</span>
                }
            </div>

            <div class="mb-3">
                <label class="form-label">Estado *</label>
                <select asp-for="estadoR" class="form-select">
                    <option value="">Seleccione un estado</option>
                    <option value="Pendiente">Pendiente</option>
                    <option value="Resuelto">Resuelto</option>
                </select>
                @if (ViewData.ModelState["estadoR"]?.Errors?.Count > 0)
                {
                    <span class="text-danger">@ViewData.ModelState["estadoR"].Errors[0].ErrorMessage</span>
                }
            </div>

            <div class="mb-3">
                <label class="form-label">Descripción *</label>
                <textarea asp-for="descripcionR" class="form-control" rows="4"></textarea>
                @if (ViewData.ModelState["descripcionR"]?.Errors?.Count > 0)
                {
                    <span class="text-danger">@ViewData.ModelState["descripcionR"].Errors[0].ErrorMessage</span>
                }
            </div>

            <button type="submit" class="btn btn-dark w-100">Crear Reporte</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelector("form").addEventListener("submit", function (e) {
            const asignacion = document.querySelector("#id_asignacionP").value;
            const estado = document.querySelector("#estadoR").value;
            const descripcion = document.querySelector("#descripcionR").value.trim();

            if (!asignacion || !estado || !descripcion) {
                alert("Por favor, complete todos los campos requeridos");
                e.preventDefault();
                return;
            }

            if (!confirm("¿Desea crear este reporte?")) {
                e.preventDefault();
            }
        });
    </script>
}