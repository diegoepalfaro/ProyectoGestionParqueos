@{
    ViewData["Title"] = "Escanear QR";
}

<h2>Escanear QR del Usuario</h2>

<div id="reader" style="width: 300px;"></div>

<div id="result"
     style="margin-top:20px; font-size: 20px; font-weight: bold;">
</div>

<!-- ✔️ El script SIEMPRE al final -->
<script src="https://unpkg.com/html5-qrcode"></script>

<script>
    function onScanSuccess(decodedText, decodedResult) {
        console.log("QR detectado:", decodedText);

        // Mostrar temporalmente el carnet
        document.getElementById("result").innerHTML =
            "Carnet detectado: " + decodedText;

        // Redirigir al controlador
        window.location.href = "/Usuario/BuscarPorQR?carnet=" + decodedText;
    }

    function onScanError(errorMessage) {
        // Error silencioso
    }

    let html5QrcodeScanner = new Html5QrcodeScanner(
        "reader",
        { fps: 10, qrbox: 250 }
    );

    html5QrcodeScanner.render(onScanSuccess, onScanError);
</script>
